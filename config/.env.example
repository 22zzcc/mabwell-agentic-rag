# 复制为 config/.env 后按需修改；不填也能以「离线默认值」跑通
# 说明：真实密钥（如 Serper、企业内部网关 token）一律放这里，且 .env 已加入 .gitignore

# ---- 本地模型服务（Ollama）----
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen3:4b
# 生产可换 bge-m3 / bge-large-zh-v1.5（需先 ollama pull）
EMBED_MODEL=mxbai-embed-large

# ---- 索引与检索 ----
INDEX_DIR=data/index
TOP_K=5
RRF_CANDIDATES=20
RRF_K=60

# ---- 分块 ----
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ---- Agent ----
MAX_STEPS=5
TEMPERATURE=0.3

# ---- 评测 ----
EVAL_K=5
